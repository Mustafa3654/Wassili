# ==========================================================
#  Wassili (وصّلي) — Local XAMPP environment configuration
#  Copy the relevant lines into your real .env after
#  `composer create-project`. APP_KEY is generated by artisan.
# ==========================================================

APP_NAME="Wassili"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Default UI locale (ar = Arabic/RTL, en = English/LTR)
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

# ---- Local XAMPP MySQL (port 3306) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wassili
DB_USERNAME=root
DB_PASSWORD=

# XAMPP default has an empty root password. Create the DB first:
#   mysql -u root -e "CREATE DATABASE wassili CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"

# ---- Wassili business settings ----
# Central call-center WhatsApp number in FULL international format, digits only (no +, no 00).
WASSILI_CALL_CENTER_NUMBER=9665XXXXXXXX
# Base delivery fee (single vendor) and the extra fee added per additional distinct vendor.
# Amounts are in USD (the base currency).
WASSILI_BASE_DELIVERY_FEE=2
WASSILI_MULTI_VENDOR_FEE=1
# Lebanese Pounds per 1 USD — drives the dual USD/LBP price display.
WASSILI_LBP_RATE=89000

SESSION_DRIVER=database
QUEUE_CONNECTION=sync
CACHE_STORE=database
MAIL_MAILER=log

# ==========================================================
#  Wassili — PRODUCTION environment (wassilli.com)
#  Copy this to `.env` on the server and fill in the blanks.
#  Never commit the real .env — it holds live credentials.
# ==========================================================

APP_NAME="Wassili"
APP_ENV=production
# Generate on the server with:  php artisan key:generate
APP_KEY=
# MUST be false in production. `true` exposes stack traces,
# database credentials and the app key to any visitor.
APP_DEBUG=false
APP_TIMEZONE=Asia/Beirut
APP_URL=https://wassilli.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

# ---- Database (create in hPanel → Databases → MySQL) ----
# Hostinger prefixes names, e.g. u123456789_wassili
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---- Wassili business settings ----
# Your real call-centre WhatsApp number: full international format,
# digits only — no +, no 00, no spaces. Lebanon example: 9613123456
WASSILI_CALL_CENTER_NUMBER=

# Delivery fees in USD (the base currency)
WASSILI_BASE_DELIVERY_FEE=2
WASSILI_MULTI_VENDOR_FEE=1

# Lebanese Pounds per 1 USD (also editable later in Admin → Settings)
WASSILI_LBP_RATE=89000

# ---- Runtime ----
# `sync` runs CSV imports/exports inline. Shared hosting has no queue
# worker, so anything else would silently never execute.
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
FILESYSTEM_DISK=local

LOG_CHANNEL=stack
LOG_LEVEL=error

# ---- Mail (optional; needed only for password reset) ----
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@wassilli.com"
MAIL_FROM_NAME="${APP_NAME}"
